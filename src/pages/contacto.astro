---
import BaseLayout from '../layouts/BaseLayout.astro';
import ajustes from '../content/ajustes.json';
const title = "Contacto | Agrupación Musical Jesús Caído";
const description = "Contacta con la Agrupación Musical Jesús Caído de Montoro para contrataciones, conciertos y colaboraciones. Email y redes sociales.";
const canonical = "https://www.amjesuscaido.es/contacto.html";
const ogTitle = "Contacto | Agrupación Musical Jesús Caído";
const ogDescription = "¿Quieres contratarnos o conocernos? Escríbenos. La agrupación de Montoro te responde.";
const ogImage = "https://www.amjesuscaido.es/img/formacion.jpg";
---
<BaseLayout title={title} description={description} canonical={canonical} ogTitle={ogTitle} ogDescription={ogDescription} ogImage={ogImage} active="contacto">
<main id="main-content">
        <section class="page-hero" aria-labelledby="page-title">
            <div class="container">
                <h1 id="page-title" class="page-title">Contacto</h1>
                <p class="page-subtitle">¿Quieres contratarnos, conocernos o preguntarnos algo?</p>
            </div>
        </section>

        <section class="section section-contacto" aria-labelledby="contacto-title">
            <div class="container">
                <header class="section-header">
                    <span class="section-tag">Contacto</span>
                    <h2 id="contacto-title" class="section-title">Datos de Contacto</h2>
                    <div class="section-divider"><span></span></div>
                </header>
                <div class="contacto-grid">
                    <div class="contacto-info">
                        <div class="contacto-item">
                            <div class="contacto-icon" aria-hidden="true">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                            </div>
                            <div>
                                <h3>Dónde estamos</h3>
                                <p>Agrupación Musical Jesús Caído<br>Montoro, Córdoba, Andalucía</p>
                            </div>
                        </div>
                        <div class="contacto-item">
                            <div class="contacto-icon" aria-hidden="true">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 6-10 7L2 6"/></svg>
                            </div>
                            <div>
                                <h3>Email</h3>
                                <p><a href={`mailto:${ajustes.email}`}>{ajustes.email}</a></p>
                            </div>
                        </div>
                        <div class="contacto-item">
                            <div class="contacto-icon" aria-hidden="true">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
                            </div>
                            <div>
                                <h3>¿Quieres tocar con nosotros?</h3>
                                <p>Todo empieza con una decisión… Ser parte de esto, no se explica, se vive. Te esperamos.</p>
                            </div>
                        </div>
                    </div>
                    <div class="contacto-redes">
                        <h3>Redes Sociales</h3>
                        <p class="contacto-redes-texto">Síguenos para estar al día de conciertos, ensayos y novedades</p>
                        <div class="redes-grid">
                            <a href={ajustes.social.facebook} target="_blank" rel="noopener" class="red-social facebook" aria-label="Facebook">
                                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                                <span>Facebook</span>
                            </a>
                            <a href={ajustes.social.instagram} target="_blank" rel="noopener" class="red-social instagram" aria-label="Instagram">
                                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                                <span>Instagram</span>
                            </a>
                            <a href={ajustes.social.tiktok} target="_blank" rel="noopener" class="red-social tiktok" aria-label="TikTok">
                                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
                                <span>TikTok</span>
                            </a>
                            <a href={ajustes.social.youtube} target="_blank" rel="noopener" class="red-social youtube" aria-label="YouTube">
                                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                                <span>YouTube</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="section section-formulario" id="formulario" aria-labelledby="formulario-title">
            <div class="container">
                <header class="section-header">
                    <span class="section-tag">Contratación</span>
                    <h2 id="formulario-title" class="section-title">Solicita Información</h2>
                    <div class="section-divider"><span></span></div>
                </header>
                <div class="formulario-container">
                    <form class="formulario" data-email={ajustes.email}>
                        <div class="form-group">
                            <label for="nombre">Nombre *</label>
                            <input type="text" id="nombre" name="nombre" autocomplete="name" required>
                        </div>
                        <div class="form-group">
                            <label for="email">Email *</label>
                            <input type="email" id="email" name="email" autocomplete="email" required>
                        </div>
                        <div class="form-group">
                            <label for="telefono">Teléfono</label>
                            <input type="tel" id="telefono" name="telefono" autocomplete="tel">
                        </div>
                        <div class="form-group">
                            <label for="tipo">Tipo de consulta *</label>
                            <select id="tipo" name="tipo" required>
                                <option value="">Selecciona...</option>
                                <option value="contratacion">Contratación Semana Santa</option>
                                <option value="concierto">Concierto / Certamen</option>
                                <option value="colaboracion">Colaboración / Entrevista</option>
                                <option value="otro">Otro</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="mensaje">Mensaje *</label>
                            <textarea id="mensaje" name="mensaje" rows="5" required placeholder="Cuéntanos qué necesitas: fecha, lugar, tipo de evento..."></textarea>
                        </div>
                        <div class="form-info" role="note">
                            <p><strong>Información básica sobre protección de datos</strong></p>
                            <p><strong>Responsable:</strong> Agrupación Musical Jesús Caído de Montoro (G14415269). <strong>Finalidad:</strong> atender tu solicitud de información o contratación. <strong>Base jurídica:</strong> tu consentimiento y, en solicitudes de contratación, la aplicación de medidas precontractuales a tu petición (art. 6.1.a y 6.1.b RGPD). <strong>Destinatarios:</strong> no se envían a ningún servicio de formularios; el mensaje llega a la cuenta de la Entidad a través de tu programa de correo. <strong>Derechos:</strong> acceso, rectificación, supresión y otros, escribiendo a <a href={`mailto:${ajustes.email}`}>{ajustes.email}</a>. <strong>Más información:</strong> <a href="privacidad.html">política de privacidad</a>.</p>
                        </div>
                        <div class="form-group form-check">
                            <input type="checkbox" id="privacidad" name="privacidad" value="Consentimiento otorgado" required>
                            <label for="privacidad">Consiento el tratamiento de mis datos para atender mi solicitud, según la <a href="privacidad.html">política de privacidad</a>. *</label>
                        </div>
                        <button type="submit" class="btn btn-primary btn-full">Enviar Solicitud</button>
                        <p class="form-nota" role="status" aria-live="polite">Al pulsar Enviar se abrirá tu programa de correo con la solicitud redactada; revísala y envíala desde ahí. También puedes escribir directamente a <a href={`mailto:${ajustes.email}`}>{ajustes.email}</a>.</p>
                    </form>
                </div>

            </div>
        </section>
    </main>
</BaseLayout>
