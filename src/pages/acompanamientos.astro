---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = "Semana Santa | Agrupación Musical Jesús Caído";
const description = "Semana Santa de la Agrupación Musical Jesús Caído en 2027: cinco hermandades de Montoro y el Domingo de Ramos en Pedro Abad.";
const canonical = "https://zorroparrasyeray-design.github.io/amjc-web/acompanamientos.html";
const ogTitle = "Semana Santa | Agrupación Musical Jesús Caído";
const ogDescription = "Cinco hermandades en Montoro y el Domingo de Ramos en Pedro Abad. La Semana Santa de 2027 de la Agrupación Musical Jesús Caído.";
const ogImage = "https://zorroparrasyeray-design.github.io/amjc-web/img/callejon-martes-santo.jpg";
---
<BaseLayout title={title} description={description} canonical={canonical} ogTitle={ogTitle} ogDescription={ogDescription} ogImage={ogImage} active="semana-santa">
<main id="main-content">
        <section class="page-hero" aria-labelledby="page-title">
            <div class="container">
                <h1 id="page-title" class="page-title">Semana Santa</h1>
                <p class="page-subtitle">Las hermandades y cofradías que acompañamos en la Semana Santa de 2027</p>
            </div>
        </section>

        <section class="section section-acompanamientos" aria-labelledby="acompanamientos-title">
            <div class="container">
                <header class="section-header">
                    <span class="section-tag">Nuestra Semana Santa</span>
                    <h2 id="acompanamientos-title" class="section-title">Dónde nos encontrarás en 2027</h2>
                    <div class="section-divider"><span></span></div>
                </header>

                <div class="acompanamientos-grid">
                    <div class="acompanamiento-col">
                        <h3 class="acompanamiento-subtitle">Hermandades en Montoro</h3>
                        <ul class="acompanamiento-list acompanamiento-list--logos">
                            <li>
                                <img src="cofradias/humildad-montoro.png" alt="Escudo de la Hermandad y Cofradía de Nazarenos del Santísimo Cristo de la Humildad y Nuestra Madre y Señora de Consolación y Esperanza" class="acompanamiento-logo" width="220" height="220" loading="lazy" decoding="async">
                                <span class="acompanamiento-text"><strong>Martes Santo:</strong> Hdad. y Cofradía de Nazarenos del Stmo. Cristo de la Humildad y Ntra. Madre y Sra. de Consolación y Esperanza.<span class="acompanamiento-salida">Salida desde la Parroquia de Ntra. Sra. del Carmen.</span></span>
                            </li>
                            <li>
                                <img src="cofradias/vera-crux-montoro.png" alt="Escudo de la Cofradía de la Santa Vera Crux" class="acompanamiento-logo" width="220" height="220" loading="lazy" decoding="async">
                                <span class="acompanamiento-text"><strong>Jueves Santo:</strong> Ntro. Padre Jesús de la Oración en el Huerto y Stmo. Cristo de la Humildad (Cofradía de la Santa Vera Crux).<span class="acompanamiento-salida">Salida desde la Iglesia de Santiago.</span></span>
                            </li>
                            <li>
                                <img src="cofradias/padre-jesus-montoro.png" alt="Escudo de la Real Cofradía de Nuestro Padre Jesús Nazareno" class="acompanamiento-logo" width="220" height="220" loading="lazy" decoding="async">
                                <span class="acompanamiento-text"><strong>Madrugá del Viernes Santo:</strong> Real Cofradía de Ntro. Padre Jesús Nazareno y María Stma. de los Dolores. «Noche de Padre Jesús».<span class="acompanamiento-salida">Salida desde la Iglesia de San Juan de Letrán.</span></span>
                            </li>
                            <li>
                                <img src="cofradias/misericordia-montoro.png" alt="Escudo de la Cofradía del Santísimo Cristo de la Misericordia y Nuestra Señora de las Angustias" class="acompanamiento-logo" width="220" height="220" loading="lazy" decoding="async">
                                <span class="acompanamiento-text"><strong>Viernes Santo:</strong> Cofradía del Stmo. Cristo de la Misericordia y Ntra. Sra. de las Angustias.<span class="acompanamiento-salida">Salida desde la Iglesia Auxiliar de San Sebastián.</span></span>
                            </li>
                            <li>
                                <img src="cofradias/resurreccion-montoro.png" alt="Escudo de la Cofradía del Santísimo Cristo Resucitado" class="acompanamiento-logo" width="220" height="220" loading="lazy" decoding="async">
                                <span class="acompanamiento-text"><strong>Domingo de Resurrección:</strong> Cofradía del Stmo. Cristo Resucitado.<span class="acompanamiento-salida">Salida desde la Ermita de la Virgen de Gracia.</span></span>
                            </li>
                        </ul>
                    </div>
                    <div class="acompanamiento-col">
                        <h3 class="acompanamiento-subtitle">Pedro Abad (Córdoba)</h3>
                        <ul class="acompanamiento-list acompanamiento-list--logos">
                            <li>
                                <img src="cofradias/borriquita-pedro-abad.png" alt="Escudo de la Hermandad de Nuestro Señor de los Reyes en su Entrada Triunfal en Jerusalén y María Santísima de la Oliva" class="acompanamiento-logo" width="220" height="220" loading="lazy" decoding="async">
                                <span class="acompanamiento-text"><strong>Domingo de Ramos:</strong> Hermandad de Nuestro Señor de los Reyes en su Entrada Triunfal en Jerusalén y María Santísima de la Oliva, de Pedro Abad.<span class="acompanamiento-salida">Salida desde la Parroquia de Ntra. Sra. de la Asunción.</span></span>
                            </li>
                        </ul>
                        <p class="acompanamiento-nota">La Semana Santa de 2027 nos llevará a Montoro y a Pedro Abad, manteniendo el compromiso con las hermandades que confían en nuestra música.</p>
                    </div>
                </div>

            </div>
        </section>

        <section class="section section-historial" aria-labelledby="historial-title">
            <div class="container">
                <header class="section-header">
                    <span class="section-tag">Trayectoria</span>
                    <h2 id="historial-title" class="section-title">Historial de la Semana Santa</h2>
                    <div class="section-divider"><span></span></div>
                </header>
                <div class="historial-content">
                    <p>La Agrupación Musical Jesús Caído ha acompañado a numerosas hermandades a lo largo de su historia, tanto en Montoro como en localidades vecinas. Algunos hitos destacados:</p>
                    <div class="historial-timeline">
                        <article class="historial-hito">
                            <span class="historial-fecha">1994</span>
                            <h3>El día que todo cambió</h3>
                            <p>La agrupación se convierte en la primera de Montoro en acompañar tronos de Cristo con el estilo de Agrupación Musical.</p>
                        </article>
                        <article class="historial-hito">
                            <span class="historial-fecha">La Madrugá</span>
                            <h3>Una cita que no falla</h3>
                            <p>Cada Madrugá, la Agrupación Musical Jesús Caído acompaña a la Real Cofradía de Ntro. Padre Jesús Nazareno. Un compromiso que se mantiene año tras año.</p>
                        </article>
                        <article class="historial-hito">
                            <span class="historial-fecha">Un hito</span>
                            <h3>Una salida para el recuerdo</h3>
                            <p>El Santísimo Cristo de la Misericordia salió de forma extraordinaria y la agrupación compartió la jornada con la A.M. Ntro. Padre Jesús Despojado, de Jaén.</p>
                        </article>
                        <article class="historial-hito">
                            <span class="historial-fecha">2022</span>
                            <h3>Montoro suena en Córdoba</h3>
                            <p>La agrupación lleva su música a la salida procesional de San Lorenzo Mártir, en Córdoba.</p>
                        </article>
                        <article class="historial-hito">
                            <span class="historial-fecha">2027</span>
                            <h3>El reencuentro con el Resucitado</h3>
                            <p>Más de una década después, la agrupación vuelve a acompañar al Santísimo Cristo Resucitado, con el que no salía desde 2016.</p>
                        </article>
                        <article class="historial-hito">
                            <span class="historial-fecha">2027</span>
                            <h3>Un nuevo destino: Pedro Abad</h3>
                            <p>El Domingo de Ramos, la agrupación acompañará a la Hermandad de Nuestro Señor de los Reyes en Pedro Abad. Una etapa nueva que amplía el mapa de la banda.</p>
                        </article>
                    </div>
                    <p class="repertorio-nota">Los horarios y recorridos pueden variar cada año. Consulta nuestras redes sociales para confirmar los detalles de la próxima Semana Santa.</p>
                </div>
            </div>
        </section>
    </main>
</BaseLayout>
