---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = "Conciertos y Certámenes | Agrupación Musical Jesús Caído";
const description = "Conciertos, certámenes y escenarios compartidos por la Agrupación Musical Jesús Caído de Montoro. Más de seis décadas de música cofrade.";
const canonical = "https://zorroparrasyeray-design.github.io/amjc-web/conciertos.html";
const ogTitle = "Conciertos y Certámenes | Agrupación Musical Jesús Caído";
const ogDescription = "Del I Congreso Nacional de Bandas al concierto de Cuaresma en Montoro. Trayectoria y escenarios compartidos.";
const ogImage = "https://zorroparrasyeray-design.github.io/amjc-web/img/formacion-atardecer.jpg";
---
<BaseLayout title={title} description={description} canonical={canonical} ogTitle={ogTitle} ogDescription={ogDescription} ogImage={ogImage} active="conciertos">
<main id="main-content">
        <section class="page-hero" aria-labelledby="page-title">
            <div class="container">
                <h1 id="page-title" class="page-title">Conciertos y Certámenes</h1>
                <p class="page-subtitle">Los escenarios donde ha sonado Montoro</p>
            </div>
        </section>

        <section class="section section-conciertos" aria-labelledby="conciertos-title">
            <div class="container">
                <header class="section-header">
                    <span class="section-tag">Trayectoria</span>
                    <h2 id="conciertos-title" class="section-title">Conciertos y Certámenes Destacados</h2>
                    <div class="section-divider"><span></span></div>
                </header>
                <div class="historial-timeline conciertos-timeline">
                    <article class="historial-hito">
                        <span class="historial-fecha">2009</span>
                        <h3>I Congreso Nacional de Bandas</h3>
                        <p>Sevilla • Casino de la Exposición y bajo la Torre del Oro</p>
                    </article>
                    <article class="historial-hito">
                        <span class="historial-fecha">2010</span>
                        <h3>ARCOAN Jaén</h3>
                        <p>Primera muestra de arte cofrade andaluz • Recinto Provincial de Ferias y Congresos</p>
                    </article>
                    <article class="historial-hito">
                        <span class="historial-fecha">2016</span>
                        <h3>I Concierto Benéfico San Pablo</h3>
                        <p>Sevilla • Parroquia San Ignacio de Loyola</p>
                    </article>
                    <article class="historial-hito">
                        <span class="historial-fecha">2016</span>
                        <h3>II FEARTECO</h3>
                        <p>Feria Nacional de Arte Cofrade • Ciudad Real</p>
                    </article>
                    <article class="historial-hito">
                        <span class="historial-fecha">2017</span>
                        <h3>V Certamen Humildad y Paciencia</h3>
                        <p>Plaza de Capuchinos • Marzo 2017</p>
                    </article>
                    <article class="historial-hito">
                        <span class="historial-fecha">2019</span>
                        <h3>III La Rosa de Oro</h3>
                        <p>Jaén • Octubre 2019</p>
                    </article>
                    <article class="historial-hito">
                        <span class="historial-fecha">2022</span>
                        <h3>Salida Procesional San Lorenzo Mártir</h3>
                        <p>Ciudad de Córdoba</p>
                    </article>
                    <article class="historial-hito">
                        <span class="historial-fecha">2023</span>
                        <h3>60 Aniversario · Concierto de Cuaresma</h3>
                        <p>Teatro Municipal Miguel Romero Esteo • Montoro</p>
                    </article>
                </div>

                <div class="section-divider section-divider--spaced"><span></span></div>

                <div class="bandas-compartidas">
                    <h3>Han compartido escenario con</h3>
                    <ul class="bandas-list bandas-list--logos">
                        <li class="banda-item">
                            <img src="bandas/pasion-linares.png" alt="Escudo de la Agrupación Musical Ntro. Padre Jesús de la Pasión, de Linares" class="banda-logo" width="200" height="200" loading="lazy" decoding="async">
                            <span class="banda-name">A.M. Ntro. Padre Jesús de la Pasión<span class="banda-place">Linares</span></span>
                        </li>
                        <li class="banda-item">
                            <img src="bandas/redencion-sevilla.png" alt="Escudo de la Agrupación Musical Ntro. Padre Jesús de la Redención, de Sevilla" class="banda-logo" width="200" height="200" loading="lazy" decoding="async">
                            <span class="banda-name">A.M. Ntro. Padre Jesús de la Redención<span class="banda-place">Sevilla</span></span>
                        </li>
                        <li class="banda-item">
                            <img src="bandas/virgen-reyes-sevilla.png" alt="Escudo de la Agrupación Musical Virgen de los Reyes, de Sevilla" class="banda-logo" width="200" height="200" loading="lazy" decoding="async">
                            <span class="banda-name">A.M. Virgen de los Reyes<span class="banda-place">Sevilla</span></span>
                        </li>
                        <li class="banda-item">
                            <span class="banda-logo-frame">
                                <img src="bandas/cigarreras-sevilla.jpg" alt="Escudo de la Cofradía de Cornetas y Tambores Ntra. Sra. de la Victoria «Cigarreras», de Sevilla" class="banda-logo" width="400" height="553" loading="lazy" decoding="async">
                            </span>
                            <span class="banda-name">C.C.T.T. Ntra. Sra. de la Victoria «Cigarreras»<span class="banda-place">Sevilla</span></span>
                        </li>
                        <li class="banda-item">
                            <img src="bandas/tres-caidas-triana.png" alt="Escudo de la Cofradía de Cornetas y Tambores Tres Caídas, de Triana" class="banda-logo" width="200" height="200" loading="lazy" decoding="async">
                            <span class="banda-name">C.C.T.T. Tres Caídas<span class="banda-place">Triana</span></span>
                        </li>
                        <li class="banda-item">
                            <img src="bandas/sol-sevilla.png" alt="Escudo de la Cofradía de Cornetas y Tambores Ntra. Sra. del Sol, de Sevilla" class="banda-logo" width="200" height="200" loading="lazy" decoding="async">
                            <span class="banda-name">C.C.T.T. Ntra. Sra. del Sol<span class="banda-place">Sevilla</span></span>
                        </li>
                        <li class="banda-item">
                            <img src="bandas/presentacion-dos-hermanas.png" alt="Escudo de la Cofradía de Cornetas y Tambores Presentación al Pueblo, de Dos Hermanas" class="banda-logo" width="200" height="200" loading="lazy" decoding="async">
                            <span class="banda-name">C.C.T.T. Presentación al Pueblo<span class="banda-place">Dos Hermanas</span></span>
                        </li>
                    </ul>
                </div>

            </div>
        </section>
    </main>
</BaseLayout>
